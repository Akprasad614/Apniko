# Copy this file to .env.production on the deployment host only.
# Do not commit the populated file.

APNIKO_DOMAIN=shop.example.com
ACME_EMAIL=ops@example.com

# Use a managed MySQL 8.x endpoint with TLS and hostname verification.
# Include the database name and sslMode=VERIFY_IDENTITY.
DB_URL="jdbc:mysql://mysql.example.com:3306/apniko?sslMode=VERIFY_IDENTITY&serverTimezone=UTC"
DB_USERNAME=apniko_runtime
DB_PASSWORD_FILE=./secrets/db_password.txt
JWT_SECRET_FILE=./secrets/jwt_secret.txt

# Use the same image tag for the rollback pair and record the deployed Git commit.
APNIKO_IMAGE_TAG=release-change-me
DB_POOL_SIZE=10
DB_MIN_IDLE=2
JWT_EXPIRATION_MS=86400000

# Optional commercial catalogue source. Leave disabled until the source owner,
# licence, commercial rights and permission reference have been reviewed.
# These values must exactly match the source approved by the project owner.
APNIKO_CATALOGUE_SOURCE_NAME=
APNIKO_CATALOGUE_SOURCE_URL=
APNIKO_CATALOGUE_SOURCE_LICENSE=
APNIKO_CATALOGUE_SOURCE_PERMISSION_REFERENCE=
APNIKO_CATALOGUE_SOURCE_RIGHTS_VERIFIED=false
APNIKO_CATALOGUE_SOURCE_COMMERCIAL_USE_PERMITTED=false
