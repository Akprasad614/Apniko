# Leave blank during local development; Vite proxies /api to localhost:8080.
# In production, prefer a same-origin reverse proxy and leave this blank.
VITE_API_BASE_URL=

# Optional map tile provider override. The default uses OpenStreetMap standard tiles.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>

# Optional reverse-geocoding provider base URL. Search and reverse lookup are user-triggered.
VITE_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
