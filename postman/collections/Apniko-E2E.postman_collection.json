      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const baseUrl = pm.environment.get(\"baseUrl\") || \"\";",
              "if (!/^https?:\\/\\/(localhost|127\\.0\\.0\\.1):8081\\/?$/.test(baseUrl)) {",
              "  throw new Error(\"Safety stop: set baseUrl to http://localhost:8081 (the isolated localcart_test instance).\");",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Checkout returns 200\", () => pm.response.to.have.status(200));",
              "const order = pm.response.json();",
              "pm.test(\"Order ID is returned\", () => pm.expect(order.id).to.exist);",
              "pm.test(\"New order starts as PLACED\", () => pm.expect(order.status).to.eql(\"PLACED\"));",
              "pm.test(\"Order uses PLATFORM_DELIVERY\", () => pm.expect(order.deliveryMode).to.eql(\"PLATFORM_DELIVERY\"));",
              "const productId = Number(pm.environment.get(\"productId\"));",
              "const orderItem = (order.items || []).find(entry => Number(entry.product && entry.product.id) === productId);",
              "pm.test(\"Order contains the cart product\", () => pm.expect(orderItem, \"order item\").to.exist);",
              "pm.test(\"Order item quantity matches the cart quantity\", () => pm.expect(Number(orderItem.quantity)).to.eql(Number(pm.environment.get(\"cartExpectedQuantity\"))));",
              "pm.environment.set(\"orderId\", order.id);",
              "pm.environment.set(\"orderTotal\", order.totalAmount);"
            ]
          }
        }
      ]
    },
