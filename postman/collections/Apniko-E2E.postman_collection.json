          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const baseUrl = pm.environment.get(\"baseUrl\") || \"\";",
              "if (!/^https?:\\/\\/(localhost|127\\.0\\.0\\.1):8081\\/?$/.test(baseUrl)) {",
              "  throw new Error(\"Safety stop: set baseUrl to http://localhost:8081 (the isolated localcart_test instance).\");",
              "}",
              "if (!pm.environment.get(\"customerEmail\") || !pm.environment.get(\"customerPassword\")) throw new Error(\"Set customerEmail and customerPassword in the private local environment first.\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Customer login returns 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test(\"Customer token is present\", () => pm.expect(data.token).to.be.a(\"string\").and.not.empty);",
              "pm.test(\"Customer role is CUSTOMER\", () => pm.expect(data.role).to.eql(\"CUSTOMER\"));",
              "pm.environment.set(\"customerToken\", data.token);",
              "pm.environment.set(\"customerUserId\", data.userId);"
            ]
          }
        }
      ]
