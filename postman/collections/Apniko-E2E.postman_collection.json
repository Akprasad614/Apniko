          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customer",
            "cart",
            "{{shopId}}",
            "checkout"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deliveryMode\": \"PLATFORM_DELIVERY\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customerToken}}",
              "type": "string"
            }
          ]
