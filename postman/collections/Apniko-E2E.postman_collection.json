    {
      "name": "Customer — capture cart quantity before add",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Cart baseline returns 200\", () => pm.response.to.have.status(200));",
              "const cart = pm.response.json();",
              "pm.test(\"Cart baseline contains an items array\", () => pm.expect(cart.items).to.be.an(\"array\"));",
              "const productId = Number(pm.environment.get(\"productId\"));",
              "const existing = cart.items.find(item => Number(item.productId) === productId);",
              "const before = existing ? Number(existing.quantity) : 0;",
              "pm.environment.set(\"cartQuantityBeforeAdd\", String(before));",
              "pm.test(\"Existing quantity is a non-negative number\", () => pm.expect(before).to.be.at.least(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
