        "url": {
          "raw": "{{baseUrl}}/api/customer/cart/{{shopId}}/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customer",
            "cart",
            "{{shopId}}",
            "items"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": {{quantity}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const baseUrl = pm.environment.get(\"baseUrl\") || \"\";",
              "if (!/^https?:\\/\\/(localhost|127\\.0\\.0\\.1):8081\\/?$/.test(baseUrl)) {",
              "  throw new Error(\"Safety stop: set baseUrl to http://localhost:8081 (the isolated localcart_test instance).\");",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Add to cart returns 200\", () => pm.response.to.have.status(200));",
              "const cart = pm.response.json();",
              "pm.test(\"Immediate POST response contains an items array\", () => pm.expect(cart.items).to.be.an(\"array\"));",
              "const productId = Number(pm.environment.get(\"productId\"));",
              "const item = cart.items.find(entry => Number(entry.productId) === productId);",
              "pm.test(\"Immediate POST response contains the configured product\", () => pm.expect(item, \"added cart item\").to.exist);",
              "const before = Number(pm.environment.get(\"cartQuantityBeforeAdd\") || 0);",
              "const added = Number(pm.environment.get(\"quantity\") || 1);",
              "const expected = before + added;",
              "pm.environment.set(\"cartExpectedQuantity\", String(expected));",
              "pm.test(\"Immediate POST response has the expected accumulated quantity\", () => pm.expect(Number(item.quantity)).to.eql(expected));"
            ]
          }
        }
      ]
    },
    {
