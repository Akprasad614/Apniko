          "script": {
            "type": "text/javascript",
            "exec": [
              "const baseUrl = pm.environment.get(\"baseUrl\") || \"\";",
              "if (!/^https?:\\/\\/(localhost|127\\.0\\.0\\.1):8081\\/?$/.test(baseUrl)) {",
              "  throw new Error(\"Safety stop: set baseUrl to http://localhost:8081 (the isolated localcart_test instance).\");",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Get cart returns 200\", () => pm.response.to.have.status(200));",
              "const cart = pm.response.json();",
              "pm.test(\"Cart total is positive\", () => pm.expect(Number(cart.totalAmount)).to.be.greaterThan(0));",
              "pm.test(\"Cart contains an items array\", () => pm.expect(cart.items).to.be.an(\"array\"));",
              "const productId = Number(pm.environment.get(\"productId\"));",
              "const item = cart.items.find(entry => Number(entry.productId) === productId);",
              "pm.test(\"GET cart contains the configured product\", () => pm.expect(item, \"cart item\").to.exist);",
              "pm.test(\"GET quantity matches the immediate POST response\", () => pm.expect(Number(item.quantity)).to.eql(Number(pm.environment.get(\"cartExpectedQuantity\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "Customer — checkout using platform delivery",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
